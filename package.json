{
  "name": "note-overlay",
  "version": "0.14.0",
  "type": "module",
  "private": true,
  "description": "A local-first Markdown notebook and daily planner that opens anywhere with one shortcut.",
  "author": "Local Notebook",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "npm run build:drag-helper && npm run build && electron .",
    "build:drag-helper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-drag-helper.ps1",
    "build": "vite build",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icon.ps1",
    "preview": "vite --host 127.0.0.1 --port 5181 --strictPort",
    "shot": "node scripts/shot.mjs",
    "test:storage": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/storage-test.cjs",
    "test:daily-timeline": "node scripts/daily-timeline-test.mjs",
    "test:bounds": "node scripts/window-bounds-test.cjs",
    "test:hotkey": "node scripts/hotkey-test.cjs && node scripts/hotkey-app-test.mjs",
    "test:handy-voice": "node scripts/handy-voice-test.cjs",
    "test:handy-voice-app": "npm run build && node scripts/handy-voice-app-test.mjs",
    "test:startup": "node scripts/startup-test.cjs",
    "test:skill-stack": "node scripts/skill-stack-test.mjs",
    "test:github-sync": "node scripts/github-sync-test.cjs",
    "test:markdown": "node scripts/markdown-test.mjs",
    "test:wikilinks": "node scripts/wikilinks-test.mjs",
    "test:rich-markdown": "node scripts/rich-markdown-test.mjs",
    "test:ui": "node scripts/ui-test.mjs",
    "test:drag": "npm run build:drag-helper && node scripts/drag-test.mjs",
    "test:drag-live": "npm run build:drag-helper && npm run build && node scripts/clean-drag-live-test.mjs",
    "test:app": "npm run build && node scripts/app-test.mjs",
    "test:keys-app": "npm run build && node scripts/keys-app-test.mjs",
    "test:memory": "node scripts/memory-sources-test.cjs",
    "test:projects-app": "npm run build && node scripts/projects-app-test.mjs",
    "test:cep": "node scripts/cep-extensions-test.cjs",
    "test:cep-ui": "node scripts/cep-extensions-ui-test.mjs",
    "test": "npm run test:storage && npm run test:daily-timeline && npm run test:projects && npm run test:cep && npm run test:memory && npm run test:bounds && npm run test:hotkey && npm run test:handy-voice && npm run test:handy-voice-app && npm run test:startup && npm run test:skill-stack && npm run test:github-sync && npm run test:markdown && npm run test:wikilinks && npm run test:rich-markdown && npm run test:format && npm run test:mail && npm run test:notion && npm run test:twitter && npm run test:excalidraw && npm run test:ai && npm run test:bots-domain && npm run test:bots-storage && npm run test:bots-monitor && npm run test:bots-provisioning && npm run test:bots-links && npm run test:bots-runtime && npm run test:bots-connector && npm run test:bots-telegram && npm run test:connector-worker && npm run test:drag && npm run test:keys-app && npm run test:app && npm run test:ui && npm run test:cep-ui && npm run test:bots-ui && npm run test:bots-app",
    "today": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/today.cjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "pack": "npm run build:drag-helper && npm run icon && npm run build && electron-builder --win nsis --publish never",
    "pack:release": "npm run build:drag-helper && npm run icon && npm run build && electron-builder --win nsis --publish never --config.win.forceCodeSigning=true",
    "pack:dir": "npm run build:drag-helper && npm run icon && npm run build && electron-builder --win --dir --publish never",
    "reset:settings": "electron scripts/reset-settings.cjs",
    "test:projects": "node scripts/projects-test.cjs && node scripts/workshop-discover-test.cjs",
    "test:bots-domain": "node scripts/bot-domain-test.cjs",
    "test:bots-storage": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/bot-storage-test.cjs",
    "test:bots-monitor": "set ELECTRON_RUN_AS_NODE=1&& electron scripts/bot-monitor-test.cjs",
    "test:bots-provisioning": "node scripts/bot-provisioning-test.cjs",
    "test:bots-links": "node scripts/bot-links-test.cjs",
    "test:bots-runtime": "node scripts/bot-runtime-test.cjs",
    "test:bots-connector": "node scripts/bot-connector-test.cjs",
    "test:bots-telegram": "node scripts/telegram-managed-bots-test.cjs",
    "test:connector-worker": "node --test services/bot-connector/test/connector.test.mjs",
    "test:bots-ui": "node scripts/bots-ui-test.mjs",
    "test:bots-app": "node scripts/bots-app-test.mjs",
    "test:mail": "node scripts/mail-view-test.cjs",
    "test:notion": "node scripts/notion-view-test.cjs",
    "test:twitter": "node scripts/twitter-view-test.cjs",
    "test:excalidraw": "node scripts/excalidraw-view-test.cjs",
    "test:ai": "node scripts/ai-view-test.cjs",
    "test:format": "node scripts/format-test.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^3.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-placeholder": "^3.30.2",
    "@tiptap/extension-task-item": "^3.30.2",
    "@tiptap/extension-task-list": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "better-sqlite3": "^12.4.1",
    "cron-parser": "^5.10.0",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "simple-icons": "^16.28.0",
    "teleproto": "^1.228.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.57.0",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "com.notebook.local",
    "productName": "Notebook",
    "directories": {
      "output": "release-v32"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "build/clean-text-drag.exe",
      "build/notebook.ico",
      "THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "build/clean-text-drag.exe"
    ],
    "publish": null,
    "icon": "build/notebook.ico",
    "win": {
      "target": "nsis",
      "artifactName": "Notebook-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
